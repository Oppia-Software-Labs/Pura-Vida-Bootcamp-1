# Baula Stellar solo admite los servicios oficiales de Testnet.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_FRIENDBOT_URL=https://friendbot.stellar.org

# Dirección pública fija. Obtenela con npm run destino. Nunca pongás una clave secreta.
NEXT_PUBLIC_DESTINATION_ADDRESS=

# Opcional. Si falta alguna credencial, el chat usa las respuestas preparadas.
RAVEN_MCP_URL=https://raven.stellar.org/mcp
# Raven puede emitir una credencial de servidor con formato nombre:token.
RAVEN_MCP_BEARER_TOKEN=
# Modelo de OpenAI para el modo en vivo.
LLM_API_KEY=
LLM_MODEL=
